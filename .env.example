# GitHub Personal Access Token (public_repo 스코프면 충분)
# 브리핑 모드에서는 선택. hall-of-fame(19회 연속 호출)과 issue 전달에는 필수
GH_PAT=

# Claude API 키 (--no-llm 사용 시 불필요)
ANTHROPIC_API_KEY=

# Slack Incoming Webhook URL (--deliver 에서 slack 을 빼면 불필요)
SLACK_WEBHOOK_URL=

# owner/repo — issue 전달에만 필요. GitHub Actions 안에서는 자동 주입된다
GITHUB_REPOSITORY=
